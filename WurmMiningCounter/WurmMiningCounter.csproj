<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\WurmMiningCounter.ico</ApplicationIcon>
    <Version>1.9.0</Version>
    <AssemblyVersion>1.9.0.0</AssemblyVersion>
    <FileVersion>1.9.0.0</FileVersion>
    <InformationalVersion>1.9.0</InformationalVersion>
    <Authors>Projekt NEXT</Authors>
    <Company>Projekt NEXT</Company>
    <Copyright>Copyright (c) 2026 Projekt NEXT</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Projekt-Next/WurmMiningCounter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\WurmMiningCounter.ico" />
  </ItemGroup>

  <Target Name="EnsureSoundsDirectoryInBuildOutput" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)Sounds" />
  </Target>

  <Target Name="EnsureSoundsDirectoryInPublishOutput" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Sounds" />
  </Target>

</Project>
