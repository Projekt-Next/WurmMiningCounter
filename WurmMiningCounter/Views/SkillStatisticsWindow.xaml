<Window x:Class="WurmMiningCounter.Views.SkillStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skill Statistics" Width="520" Height="720" MinWidth="500" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#FFFDFEFF">
    <Window.Resources>
        <CollectionViewSource x:Key="ProfileOptions" Source="{Binding Profiles}">
            <CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"/></CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <DataTemplate x:Key="ProfileItemTemplate"><TextBlock Text="{Binding ProfileName}" TextTrimming="CharacterEllipsis"/></DataTemplate>
        <DataTemplate x:Key="ProfileSelectionTemplate"><TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/></DataTemplate>
        <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="#FF536B8C"/></Style>
        <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="#FF10254A"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
        <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
        <Style x:Key="FrameTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#FF334B70"/></Style>
        <Style x:Key="ProfileComboBoxItem" TargetType="ComboBoxItem"><Setter Property="Height" Value="31"/><Setter Property="Padding" Value="12,0"/><Setter Property="Foreground" Value="#FF10254A"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="White" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#FFF5FAFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#FFE6F3FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ProfileComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/><Setter Property="Foreground" Value="#FF10254A"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#FFD5DFEA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ItemContainerStyle" Value="{StaticResource ProfileComboBoxItem}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/><ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Grid><ContentPresenter Margin="10,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{StaticResource ProfileSelectionTemplate}"/><Path Data="M 0,0 L 5,5 L 10,0" Stroke="#FF536B8C" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" Margin="0,0,13,0" VerticalAlignment="Center"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="White" BorderBrush="#FFD5DFEA" BorderThickness="1" CornerRadius="8"><Border.Effect><DropShadowEffect Color="#33000000" ShadowDepth="2" BlurRadius="8" Opacity="0.25"/></Border.Effect><ScrollViewer MaxHeight="220" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#FFF5FAFF"/><Setter TargetName="Root" Property="BorderBrush" Value="#FF94C7FC"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#FF0879E8"/></Trigger><Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#FF0879E8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StatisticsTextBox" TargetType="TextBox"><Setter Property="Padding" Value="6,3"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#FFD3DDE8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Width="8" Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Background="Transparent" BorderThickness="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="6" Margin="1,3" Background="#FFB9C9DA" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Background="Transparent" BorderThickness="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="StatisticsDataGrid" TargetType="DataGrid"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#FFE9EEF4"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="White"/><Setter Property="RowHeight" Value="31"/><Setter Property="CanUserResizeRows" Value="False"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Height" Value="32"/><Setter Property="Background" Value="#FFF8FAFD"/><Setter Property="Foreground" Value="#FF536B8C"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Padding" Value="10,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#FFE3EAF2"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,0,10,0"/><Setter Property="Foreground" Value="#FF10254A"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFEFF7FF"/></Trigger></Style.Triggers></Style>
        <Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#FF10254A"/><Setter Property="FontSize" Value="13.5"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFF5FAFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFEFF7FF"/></Trigger></Style.Triggers></Style>
        <Style x:Key="OtherSkillsHeaderLeft" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,0,6,0"/></Style>
        <Style x:Key="OtherSkillsHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Padding" Value="6,0,12,0"/></Style>
        <Style x:Key="OtherSkillsSkillText" TargetType="TextBlock"><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="#FF10254A"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="12,0,6,0"/></Style>
        <Style x:Key="OtherSkillsCurrentText" TargetType="TextBlock"><Setter Property="Foreground" Value="#FF10254A"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0,12,0"/></Style>
        <Style x:Key="OtherSkillsLastGainText" TargetType="TextBlock" BasedOn="{StaticResource OtherSkillsCurrentText}"><Setter Property="Foreground" Value="#FF0879E8"/></Style>
        <Style x:Key="OtherSkillsSessionGainText" TargetType="TextBlock" BasedOn="{StaticResource OtherSkillsCurrentText}"><Setter Property="Foreground" Value="#FF2E7D32"/></Style>
    </Window.Resources>
    <Grid Margin="28,24,28,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Skill statistics" VerticalAlignment="Center" FontSize="23" FontWeight="SemiBold" Foreground="#FF10254A"/><ComboBox Grid.Column="1" Width="240" Style="{StaticResource ProfileComboBox}" ItemsSource="{Binding Source={StaticResource ProfileOptions}}" ItemTemplate="{StaticResource ProfileItemTemplate}" SelectedValuePath="ProfileId" SelectedValue="{Binding SelectedProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VirtualizingPanel.IsVirtualizingWhenGrouping="True"><ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"/></ItemsPanelTemplate></ComboBox.ItemsPanel><ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Grid Margin="12,7,12,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name.DisplayName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FF536B8C" VerticalAlignment="Center"/><Border Grid.Column="1" Height="1" Margin="8,0,0,0" Background="#FFDCE5EF" VerticalAlignment="Center"/></Grid></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle></ComboBox></Grid>
        <Grid Grid.Row="1" Margin="0,0,0,13">
            <Border Margin="0,8,0,0" Padding="18,17,18,16" Background="White" BorderBrush="#FFD5DFEA" BorderThickness="1" CornerRadius="9">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Stretch"><TextBlock Text="Current" Style="{StaticResource MetricLabel}" TextAlignment="Center"/><TextBlock Text="{Binding MiningCurrentDisplay}" Style="{StaticResource KpiValue}" HorizontalAlignment="Stretch" TextAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Stretch"><TextBlock Text="Last gain" Style="{StaticResource MetricLabel}" TextAlignment="Center"/><TextBlock Text="{Binding MiningLastGainDisplay}" Style="{StaticResource KpiValue}" HorizontalAlignment="Stretch" TextAlignment="Center" Foreground="#FF0879E8" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Stretch"><TextBlock Text="Session gain" Style="{StaticResource MetricLabel}" TextAlignment="Center"/><TextBlock Text="{Binding MiningSessionGainDisplay}" Style="{StaticResource KpiValue}" HorizontalAlignment="Stretch" TextAlignment="Center" Foreground="#FF2E7D32" Margin="0,3,0,0"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,15,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Gain / hour" Style="{StaticResource MetricLabel}"/><TextBlock Grid.Column="1" Text="{Binding MiningGainPerHourDisplay}" Style="{StaticResource MetricValue}"/></Grid>
                        <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Next milestone" Style="{StaticResource MetricLabel}"/><TextBlock Grid.Column="1" Text="{Binding NextMiningMilestoneDisplay}" Style="{StaticResource MetricValue}" Margin="8,0,0,0"/></Grid>
                            <Grid Grid.Column="1" Margin="12,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Time to milestone" Style="{StaticResource MetricLabel}"/><TextBlock Grid.Column="1" Text="{Binding MiningTimeToMilestoneDisplay}" Style="{StaticResource MetricValue}" Margin="8,0,0,0"/></Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border Background="#FFFDFEFF" Padding="6,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,0,0,0"><TextBlock Text="Mining" Style="{StaticResource FrameTitle}"/></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,14"><Border Margin="0,8,0,0" Padding="18,17,18,15" Background="White" BorderBrush="#FFD5DFEA" BorderThickness="1" CornerRadius="9"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Successful actions" Style="{StaticResource MetricLabel}"/><TextBlock Grid.Column="1" Text="{Binding SuccessfulActionsDisplay}" Style="{StaticResource MetricValue}" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="Mining ticks" Style="{StaticResource MetricLabel}" Margin="0,7,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MiningTickCountDisplay}" Style="{StaticResource MetricValue}" FontWeight="SemiBold" Margin="0,7,0,0"/><Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Margin="0,5,0,4" Background="#FFE3EAF2"/><TextBlock Grid.Row="3" Text="Tick rate" Style="{StaticResource MetricLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TickRatePercentDisplay}" Style="{StaticResource MetricValue}" Foreground="#FF2E7D32" FontWeight="SemiBold"/><TextBlock Grid.Row="4" Text="Actions / tick" Style="{StaticResource MetricLabel}" Margin="0,7,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActionsPerTickDisplay}" Style="{StaticResource MetricValue}" Margin="0,7,0,0"/><TextBlock Grid.Row="5" Text="Avg gain / tick" Style="{StaticResource MetricLabel}" Margin="0,7,0,0"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AverageGainPerTickDisplay}" Style="{StaticResource MetricValue}" Margin="0,7,0,0"/><TextBlock Grid.Row="6" Text="Average ticks / hour" Style="{StaticResource MetricLabel}" Margin="0,7,0,0"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TicksPerHourDisplay}" Style="{StaticResource MetricValue}" Margin="0,7,0,0"/></Grid><Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Avg ticks / " Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/><TextBox Width="42" Margin="4,0" Style="{StaticResource StatisticsTextBox}" Text="{Binding SelectedActionCountText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text=" actions" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding TicksPerSelectedActionsDisplay}" Style="{StaticResource MetricValue}" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Grid></Border><Border Background="#FFFDFEFF" Padding="6,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,0,0,0"><TextBlock Text="Current Mining Session" Style="{StaticResource FrameTitle}"/></Border></Grid>
        <Grid Grid.Row="3">
            <Border Margin="0,8,0,0" Background="White" BorderBrush="#FFD5DFEA" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                <Grid Margin="0,8,0,0">
                    <DataGrid ItemsSource="{Binding OtherSkills}" Style="{StaticResource StatisticsDataGrid}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Skill" HeaderStyle="{StaticResource OtherSkillsHeaderLeft}" Binding="{Binding SkillName}" SortMemberPath="SkillName" Width="1.35*" ElementStyle="{StaticResource OtherSkillsSkillText}"/>
                            <DataGridTextColumn Header="Current" HeaderStyle="{StaticResource OtherSkillsHeaderRight}" Binding="{Binding CurrentValue, StringFormat={}{0:0.######}}" SortMemberPath="CurrentValue" Width="1*" ElementStyle="{StaticResource OtherSkillsCurrentText}"/>
                            <DataGridTextColumn Header="Last Gain" HeaderStyle="{StaticResource OtherSkillsHeaderRight}" Binding="{Binding LastGain, TargetNullValue=—, StringFormat={}{0:0.######}}" SortMemberPath="LastGain" Width="1*" ElementStyle="{StaticResource OtherSkillsLastGainText}"/>
                            <DataGridTextColumn Header="Session Gain" HeaderStyle="{StaticResource OtherSkillsHeaderRight}" Binding="{Binding SessionGain, StringFormat={}{0:0.######}}" SortMemberPath="SessionGain" Width="1.1*" ElementStyle="{StaticResource OtherSkillsSessionGainText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No other skills observed this session." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF536B8C" FontSize="13"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasOtherSkills}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Grid>
            </Border>
            <Border Background="#FFFDFEFF" Padding="6,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,0,0,0"><TextBlock Text="Other Skills" Style="{StaticResource FrameTitle}"/></Border>
        </Grid>
    </Grid>
</Window>
