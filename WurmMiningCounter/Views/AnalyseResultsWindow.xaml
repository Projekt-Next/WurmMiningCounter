<Window x:Class="WurmMiningCounter.Views.AnalyseResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wurm Mining Counter – Analyse" Width="600" Height="687" MinWidth="600" MinHeight="604"
        WindowStartupLocation="CenterOwner" Background="#FFFDFEFF">
    <Window.Resources>
        <Style x:Key="AnalyseScrollBar" TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Width="8" Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Background="Transparent" BorderThickness="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="6" Margin="1,3" Background="#FFB9C9DA" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Background="Transparent" BorderThickness="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#FFD5DBE1"/>
            <Setter Property="Background" Value="#FFF7F8FA"/>
            <Setter Property="Foreground" Value="#FF10254A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>
        <Grid Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,4"><TextBlock Text="Character:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ProfileSelector" Width="180" DisplayMemberPath="Name" SelectionChanged="OnProfileSelectionChanged"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,4"><TextBlock Text="Material:" VerticalAlignment="Center" Margin="0,0,6,0"/><Border Background="#FFE5EFFD" BorderBrush="#FF9DBBE7" BorderThickness="1" CornerRadius="4" Padding="9,4"><TextBlock x:Name="InputText" FontWeight="Bold" VerticalAlignment="Center"/></Border></StackPanel>
                <TextBlock x:Name="FinishTimeText" Text="Last analysis: time unavailable" Foreground="#FF536B8C" VerticalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock x:Name="ProfileText" Visibility="Collapsed"/>
            </WrapPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <GroupBox x:Name="VeinsSection" Header="Detected veins" Margin="0,0,6,0" Padding="10,10,1,10">
                    <Grid>
                        <ScrollViewer x:Name="VeinsScroll" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AnalyseScrollBar}"/></ScrollViewer.Resources>
                            <ItemsControl x:Name="VeinsList" Margin="0,0,4,0">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="#FFD5DBE1" BorderThickness="1" CornerRadius="5" Background="White" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Background="{Binding Color}" CornerRadius="4"/>
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                <TextBlock Text="{Binding Material}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Details}" FontSize="12" FontWeight="Normal" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#FFE5EFFD" BorderBrush="#FFB5CEF1" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center"><TextBlock Text="{Binding Tiles}" FontSize="12" FontWeight="Normal"/></Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyText" Text="No completed analysis for this profile." TextWrapping="Wrap" Foreground="#FF536B8C" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </GroupBox>
                <GroupBox Grid.Column="1" Header="Vein map" Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid HorizontalAlignment="Center">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="NW"/><TextBlock Grid.Column="1" Text="N" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="NE"/>
                            <TextBlock Grid.Row="1" Text="W" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Viewbox Grid.Row="1" Grid.Column="1" Stretch="Uniform" MaxWidth="300" MaxHeight="300"><Grid x:Name="MapGrid" Width="300" Height="300"/></Viewbox>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="E" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBlock Grid.Row="2" Text="SW"/><TextBlock Grid.Row="2" Grid.Column="1" Text="S" HorizontalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="2" Text="SE"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock Text="Distance from mining location" FontSize="12" FontWeight="SemiBold" Foreground="#FF536B8C" TextWrapping="Wrap"/>
                            <TextBlock x:Name="LegendText" Text="1 Trace · 2 Slight · 3 Faint · 4 Minuscule · 5 Vague · 6 Indistinct" FontSize="12" TextWrapping="Wrap" FontWeight="Normal" Foreground="#FF536B8C"/>
                        </StackPanel>
                        <TextBlock x:Name="MapNoteText" Grid.Row="2" Text="Approximate positions; the map does not show the exact vein tile." FontSize="12" TextWrapping="Wrap" FontWeight="Normal" Foreground="#FF536B8C" Margin="0,4,0,0"/>
                    </Grid>
                </GroupBox>
            </Grid>
            <GroupBox Grid.Row="2" x:Name="EntriesSection" Header="Analysis details" Margin="0,12,0,0" Padding="10,10,1,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Recognized log information is shown. Unsupported messages may be omitted." FontSize="12" Foreground="#FF536B8C" FontWeight="Normal" TextWrapping="Wrap" Margin="0,0,6,8"/>
                    <ScrollViewer Grid.Row="1" x:Name="EntriesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AnalyseScrollBar}"/></ScrollViewer.Resources>
                        <ItemsControl x:Name="EntriesList" Margin="0,0,4,0"><ItemsControl.ItemTemplate><DataTemplate>
                            <TextBlock FontSize="13" TextWrapping="Wrap" FontWeight="Normal" Margin="0,0,0,8"><Run Text="{Binding Prefix}"/><Run Text="{Binding Material}" FontWeight="Bold"/><Run Text="{Binding Suffix}"/></TextBlock>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>
</Window>
