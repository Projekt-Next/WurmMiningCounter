<Window x:Class="WurmMiningCounter.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WurmMiningCounter.Views"
        WindowStyle="None"
        ResizeMode="CanResize"
        Topmost="False"
        Background="White"
        Width="360" Height="390"
        MinWidth="300" MinHeight="350"
        WindowStartupLocation="Manual">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="Transparent"
              MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Settings"
                       FontSize="11"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    Width="22"
                    Height="20"
                    Margin="8,0,0,0"
                    Padding="0"
                    BorderThickness="0"
                    Content="&#x00D7;"
                    FontSize="14"
                    Click="OnCloseButtonClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#FF5F6368" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF0F1F3" />
                                <Setter Property="Foreground" Value="#FF3C4043" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <TabControl Grid.Row="1" Margin="0,14,0,8">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <GroupBox Header="Session"
                              Margin="0,0,0,12"
                              Padding="12"
                              Background="#FFF7F8FA"
                              BorderBrush="#FFD5DBE1"
                              BorderThickness="1"
                              FontWeight="SemiBold">
                        <Button HorizontalAlignment="Left"
                                FontWeight="Normal"
                                Content="Reset Session"
                                Click="OnResetSessionClick" />
                    </GroupBox>
                    <GroupBox Header="Application"
                              Margin="0,0,0,12"
                              Padding="12"
                              Background="#FFF7F8FA"
                              BorderBrush="#FFD5DBE1"
                              BorderThickness="1"
                              FontWeight="SemiBold">
                        <StackPanel>
                            <CheckBox FontWeight="Normal"
                                      Content="Always on top"
                                      IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
                            <CheckBox Margin="0,8,0,0"
                                      FontWeight="Normal"
                                      Content="Start minimized to tray"
                                      IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Log locations"
                              Padding="12"
                              Background="#FFF7F8FA"
                              BorderBrush="#FFD5DBE1"
                              BorderThickness="1"
                              FontWeight="SemiBold">
                        <StackPanel TextElement.FontWeight="Normal">
                            <TextBlock Foreground="#FF5F6368"
                                       Text="{Binding LocationDiscoveryStatusText}"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding DiscoveryRootCount}" />
                                    <TextBlock Foreground="#FF5F6368" FontSize="10" Text="Roots" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding DiscoveryProfileCount}" />
                                    <TextBlock Foreground="#FF5F6368" FontSize="10" Text="Profiles" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding DiscoveryEventFileCount}" />
                                    <TextBlock Foreground="#FF5F6368" FontSize="10" Text="Event" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding DiscoverySkillsFileCount}" />
                                    <TextBlock Foreground="#FF5F6368" FontSize="10" Text="Skills" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button Content="Find locations"
                                        IsEnabled="{Binding CanFindLocations}"
                                        Click="OnFindLocationsClick" />
                                <Button Margin="8,0,0,0"
                                        Content="Manage log locations"
                                        Click="OnManageLogLocationsClick" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <GroupBox Header="Diagnostic logging"
                              Margin="0,0,0,12"
                              Padding="12"
                              Background="#FFF7F8FA"
                              BorderBrush="#FFD5DBE1"
                              BorderThickness="1"
                              FontWeight="SemiBold">
                    <StackPanel TextElement.FontWeight="Normal">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Status: " />
                            <TextBlock Text="{Binding DiagnosticsStatusText}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF137333" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiagnosticsEnabled}" Value="False">
                                                <Setter Property="Foreground" Value="#FFC5221F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Margin="0,8,0,0"
                                  Content="Enable runtime diagnostics"
                                  IsChecked="{Binding DiagnosticsEnabled, Mode=TwoWay}" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding DiagnosticEntryCountText}" />
                        <TextBlock Margin="0,3,0,0" Text="Storage: Memory only" />
                    </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Diagnostic log"
                              Padding="12"
                              Background="#FFF7F8FA"
                              BorderBrush="#FFD5DBE1"
                              BorderThickness="1"
                              FontWeight="SemiBold">
                    <StackPanel TextElement.FontWeight="Normal">
                    <TextBlock Foreground="#FF5F6368"
                               TextWrapping="Wrap"
                               Text="View runtime events, warnings and errors." />
                    <Button Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Content="Open Diagnostics Window"
                            Click="OnOpenDiagnosticsWindowClick" />
                    <Button Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Foreground="#FFC5221F"
                            Content="Clear Diagnostic Log"
                            Click="OnClearDiagnosticLogClick" />
                    </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   HorizontalAlignment="Right"
                   Foreground="#FF80868B"
                   FontSize="10"
                   Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType={x:Type local:SettingsWindow}}}" />
    </Grid>
</Window>
