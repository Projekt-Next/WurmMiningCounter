<Window x:Class="WurmMiningCounter.Views.AlertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerts" Width="1140" Height="590" MinWidth="960" MinHeight="520" Background="#FFFDFEFF">
    <Window.Resources>
        <Style x:Key="EnabledCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Box" CornerRadius="4" Background="White" BorderBrush="#FFB9C5D5" BorderThickness="1"><Path x:Name="Check" Data="M 4,9 L 7.5,13 L 14.5,5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#FF0879E8"/><Setter TargetName="Box" Property="BorderBrush" Value="#FF0879E8"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AlertToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="38"/><Setter Property="Height" Value="20"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Track" CornerRadius="10" Background="#FFA9B6C8"><Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3" HorizontalAlignment="Left" Fill="White"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#FF0879E8"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="82"/><Setter Property="Padding" Value="18,0"/><Setter Property="Foreground" Value="#FF10254A"/><Setter Property="Background" Value="#FFFAFCFF"/><Setter Property="BorderBrush" Value="#FFC8D3E0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#FFF2F7FC"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#FFE7F1FB"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.58"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="90"/><Setter Property="Padding" Value="18,0"/><Setter Property="Foreground" Value="#FFD32222"/><Setter Property="Background" Value="#FFFFFBFB"/><Setter Property="BorderBrush" Value="#FFF27272"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#FFFFF0F1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#FFFFE3E5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.58"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#FFF2F7FC"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#FFE7F1FB"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DeleteIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#FFFFF0F1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#FFFFE3E5"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="86"/><Setter Property="Padding" Value="16,0"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#FF0879E8"/><Setter Property="BorderBrush" Value="#FF0879E8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#FF0569CC"/><Setter TargetName="Border" Property="BorderBrush" Value="#FF0569CC"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#FF0457AA"/><Setter TargetName="Border" Property="BorderBrush" Value="#FF0457AA"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Background" Value="#FFE5EEF8"/><Setter TargetName="Border" Property="BorderBrush" Value="#FFD3E0EE"/><Setter Property="Foreground" Value="#FF8FA2B8"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="EditorTextBox" TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#FFD3DDE8"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="AlertListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="White"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="#FFE3EAF2" BorderThickness="0,0,0,1"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#FFF5FAFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#FFE6F3FF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="36,28,36,36">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Alert triggers" FontSize="23" FontWeight="SemiBold" Foreground="#FF10254A"/>
                <Button Grid.Column="2" Click="OnAddClick" Height="36" Background="#FFEAF5FF" BorderBrush="#FF94C7FC" BorderThickness="1" Foreground="#FF096DD8" FontSize="16" FontWeight="SemiBold">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="AddBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AddBorder" Property="Background" Value="#FFDDF0FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="AddBorder" Property="Background" Value="#FFD2EAFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="+" FontSize="26" FontWeight="Normal" Margin="0,-3,9,0"/><TextBlock Text="Add trigger" VerticalAlignment="Center"/></StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="2" Background="White" BorderBrush="#FFD5DFEA" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#FFF5F8FC" BorderBrush="#FFDCE5EE" BorderThickness="0,0,0,1">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="10*"/><ColumnDefinition Width="18*"/><ColumnDefinition Width="27*"/><ColumnDefinition Width="16*"/><ColumnDefinition Width="16*"/><ColumnDefinition Width="13*"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="Enabled" FontSize="14" FontWeight="SemiBold" Foreground="#FF334B70"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Text="Name" FontSize="14" FontWeight="SemiBold" Foreground="#FF334B70"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0" Text="Trigger text" FontSize="14" FontWeight="SemiBold" Foreground="#FF334B70"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid Width="18" Height="18" Margin="0,0,6,0"><Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="18" Height="18"><Path Data="M1.5,7 L5.5,7 L10,3.5 L10,14.5 L5.5,11 L1.5,11 Z M12.5,6 C14,7.5 14,10.5 12.5,12 M14.5,4 C17,6.5 17,11.5 14.5,14" Stroke="#FF536B8C" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Grid><TextBlock VerticalAlignment="Center" Text="Sound" FontSize="14" FontWeight="SemiBold" Foreground="#FF334B70"/></StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid Width="18" Height="18" Margin="0,0,6,0"><Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="18" Height="18"><Path Data="M9,3 C13.5,3 16.5,5.5 16.5,9 C16.5,12.5 13.2,15 9,15 C7.4,15 6,14.7 4.7,14 L1.8,16 L2.8,12.8 C1.9,11.7 1.5,10.4 1.5,9 C1.5,5.5 4.5,3 9,3 Z" Stroke="#FF536B8C" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Grid><TextBlock VerticalAlignment="Center" Text="Popup" FontSize="14" FontWeight="SemiBold" Foreground="#FF334B70"/></StackPanel>
                            <TextBlock Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Actions" FontSize="14" FontWeight="SemiBold" Foreground="#FF334B70"/>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding AlertTriggers}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource AlertListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Height="40" Margin="12,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="10*"/><ColumnDefinition Width="18*"/><ColumnDefinition Width="27*"/><ColumnDefinition Width="16*"/><ColumnDefinition Width="16*"/><ColumnDefinition Width="13*"/></Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource EnabledCheckBox}" IsEnabled="{Binding AreTogglesEnabled}" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}" Checked="OnEnabledChanged" Unchecked="OnEnabledChanged"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Text="{Binding Name}" FontSize="14.5" Foreground="#FF10254A" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0" Text="{Binding MatchText}" FontSize="14.5" Foreground="#FF243A5B" TextTrimming="CharacterEllipsis"/>
                                <CheckBox Grid.Column="3" Style="{StaticResource AlertToggle}" IsEnabled="{Binding AreTogglesEnabled}" IsChecked="{Binding SoundEnabled, Mode=OneWay}" Tag="{Binding}" Checked="OnSoundEnabledChanged" Unchecked="OnSoundEnabledChanged"/>
                                <CheckBox Grid.Column="4" Style="{StaticResource AlertToggle}" IsEnabled="{Binding AreTogglesEnabled}" IsChecked="{Binding PopupEnabled, Mode=OneWay}" Tag="{Binding}" Checked="OnPopupEnabledChanged" Unchecked="OnPopupEnabledChanged"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Style="{StaticResource IconButton}" ToolTip="Edit" Tag="{Binding}" Click="OnEditClick"><Path Width="18" Height="18" Stretch="Uniform" Data="M3,21 L8,20 L20,8 L16,4 L4,16 Z M14,6 L18,10" Stroke="#FF334B70" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeLineJoin="Round"/></Button><Button Style="{StaticResource DeleteIconButton}" ToolTip="Delete" Margin="3,0,0,0" Tag="{Binding}" Click="OnDeleteClick" Visibility="{Binding DeleteVisibility}"><Path Width="18" Height="18" Stretch="Uniform" Data="M7,7 L17,7 L16,21 L8,21 Z M5,7 L19,7 M9,7 L10,4 L14,4 L15,7 M10,11 L10,17 M14,11 L14,17" Stroke="#FFD32222" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeLineJoin="Round"/></Button><Border Width="26" Height="26" Margin="3,0,0,0" VerticalAlignment="Center" Visibility="{Binding LockVisibility}"><Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M6,10 L6,7 A6,6 0 0 1 18,7 L18,10 M4,10 L20,10 L20,21 L4,21 Z M12,14 L12,17" Stroke="#FF9AA8BB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"/></Border></StackPanel>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <TextBlock Grid.Row="3" Margin="2,10,2,0" Foreground="#FFC5221F" FontSize="13" Text="{Binding ErrorMessage}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <Border Grid.Column="1" Margin="26,0,0,0" Width="340" Padding="22" Background="#FFFCFDFF" BorderBrush="#FFD5DFEA" BorderThickness="1" CornerRadius="9" Visibility="{Binding EditorVisibility}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding EditorTitle}" FontSize="22" FontWeight="SemiBold" Foreground="#FF10254A"/>
                <TextBlock Grid.Row="1" Margin="0,22,0,0" Text="Name" FontWeight="SemiBold" Foreground="#FF334B70"/><TextBox Grid.Row="2" Margin="0,6,0,14" Style="{StaticResource EditorTextBox}" IsEnabled="{Binding Editor.CanEditDetails}" Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="3" Text="Trigger words / phrase" FontWeight="SemiBold" Foreground="#FF334B70"/><TextBox Grid.Row="4" Margin="0,6,0,14" Style="{StaticResource EditorTextBox}" IsEnabled="{Binding Editor.CanEditDetails}" Text="{Binding Editor.MatchText, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Row="5"><CheckBox Content="Sound enabled" IsChecked="{Binding Editor.SoundEnabled}" Margin="0,0,0,10"/><TextBlock Text="Sound file" FontWeight="SemiBold" Foreground="#FF334B70"/><ComboBox Margin="0,6,0,16" Padding="6" ItemsSource="{Binding Sounds}" SelectedItem="{Binding Editor.SoundFileName}"/><CheckBox Content="Popup enabled" IsChecked="{Binding Editor.PopupEnabled}" Margin="0,0,0,10"/><TextBlock Text="Popup text" FontWeight="SemiBold" Foreground="#FF334B70"/><TextBox Margin="0,6,0,0" Style="{StaticResource EditorTextBox}" IsEnabled="{Binding Editor.CanEditDetails}" Text="{Binding Editor.PopupText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Row="7" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource ActionButton}" Width="86" Margin="0,0,8,0" Content="Cancel" Click="OnCancelClick"/><Button Style="{StaticResource PrimaryButton}" Width="86" Content="Save" Click="OnSaveEditorClick"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
