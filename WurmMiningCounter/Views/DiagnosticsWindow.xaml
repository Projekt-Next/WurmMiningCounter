<Window x:Class="WurmMiningCounter.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics"
        Width="900"
        Height="500"
        MinWidth="600"
        MinHeight="300"
        Topmost="False"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid x:Name="DiagnosticsGrid"
                  ItemsSource="{Binding Entries}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#FFE1E5E8"
                  PreviewKeyDown="OnDiagnosticsGridPreviewKeyDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding LocalTimestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff zzz}}" Width="190" />
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="75" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="170" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="NoWrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Clear" Click="OnClearClick" />
            <Button Margin="8,0,0,0" Content="Copy Selected" Click="OnCopySelectedClick" />
            <Button Margin="8,0,0,0" Content="Copy All" Click="OnCopyAllClick" />
            <Button Margin="8,0,0,0" Content="Save Log" Click="OnSaveLogClick" />
            <Button Margin="8,0,0,0" Content="Close" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
