<Window x:Class="WurmMiningCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:WurmMiningCounter.Models"
        mc:Ignorable="d"
        Icon="Resources/WurmMiningCounter.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="200"
        MinWidth="185"
        MaxWidth="280"
        MinHeight="96"
        MaxHeight="620"
        SizeToContent="Height"
        Background="White">
    <Window.Resources>
        <DataTemplate x:Key="ProfileGroupBoxHeaderTemplate">
            <TextBlock Text="{Binding}"
                       FontWeight="Bold" />
        </DataTemplate>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="#FFF7F8FA" />
            <Setter Property="BorderBrush" Value="#FFD5DBE1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="#FF80868B" />
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip MaxWidth="300">
                        <TextBlock Text="Stan monitoringu jest nieznany."
                                   TextWrapping="Wrap" />
                    </ToolTip>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="Monitoring">
                    <Setter Property="Fill" Value="#FF2E7D32" />
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip MaxWidth="300">
                                <TextBlock Text="Monitoring logów jest aktywny. Program oczekuje na nowe wpisy Event i automatycznie zlicza nowe wyniki Mining."
                                           TextWrapping="Wrap" />
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="Monitoring unavailable">
                    <Setter Property="Fill" Value="#FF80868B" />
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip MaxWidth="300">
                                <TextBlock Text="Monitoring jest niedostępny. Nie znaleziono katalogu danych Wurm Online w lokalizacji %UserProfile%\wurm\players."
                                           TextWrapping="Wrap" />
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="Monitoring error">
                    <Setter Property="Fill" Value="#FFC62828" />
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip MaxWidth="300">
                                <TextBlock Text="Monitoring nie został uruchomiony z powodu błędu. Nowe wyniki Mining nie będą zliczane do czasu ponownego uruchomienia aplikacji."
                                           TextWrapping="Wrap" />
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="Monitoring identity warning">
                    <Setter Property="Fill" Value="#FFF9A825" />
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip MaxWidth="300">
                                <TextBlock Text="Część źródeł logów jest zablokowana przez weryfikację tożsamości. Pozostałe źródła są nadal monitorowane."
                                           TextWrapping="Wrap" />
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="Monitoring identity error">
                    <Setter Property="Fill" Value="#FFC62828" />
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip MaxWidth="300">
                                <TextBlock Text="Źródła logów zostały zablokowane przez weryfikację tożsamości. Monitoring nie jest aktywny dla tych źródeł."
                                           TextWrapping="Wrap" />
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Background="Transparent"
              MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Margin="0,0,5,0"
                     Style="{StaticResource StatusIndicatorStyle}"
                     MouseLeftButtonDown="OnStatusIndicatorMouseLeftButtonDown"
                     VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="Wurm Mining Counter"
                       FontSize="10"
                       FontWeight="SemiBold" />
            <Button Grid.Column="2"
                    Width="22"
                    Height="20"
                    Margin="8,0,0,0"
                    Padding="0"
                    BorderThickness="0"
                    Content="−"
                    FontSize="14"
                    ToolTip="Minimize"
                    Click="OnMinimizeClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#FF5F6368" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF0F1F3" />
                                <Setter Property="Foreground" Value="#FF3C4043" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="0,8,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ProfilePanels.Count}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel>
                <ItemsControl ItemsSource="{Binding ProfilePanels}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8"
                                  HorizontalAlignment="Stretch">
                                <GroupBox HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Header="{Binding ProfileName}"
                                          HeaderTemplate="{StaticResource ProfileGroupBoxHeaderTemplate}">
                                    <StackPanel Margin="8,8,8,10">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#x26CF;" Margin="0,0,3,0" FontSize="10" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding LiveMiningCurrentDisplay}" ToolTip="{Binding LiveMiningCurrentDisplay}"
                                                           TextTrimming="CharacterEllipsis" Foreground="#2563EB" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding LiveMiningGainDisplay}" ToolTip="{Binding LiveMiningGainDisplay}"
                                                           Margin="6,0,0,0" TextTrimming="CharacterEllipsis" Foreground="#15803D" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                            <Button Grid.Column="1" Height="12" Padding="0" Margin="2,0,0,0"
                                                    FontSize="9" Foreground="#FF2563EB" Background="Transparent" BorderThickness="0"
                                                    ToolTip="Show Analyse results" Click="OnAnalyseClick">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAnalyseResult}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⌕" Margin="0,0,2,0" />
                                                    <TextBlock Text="Analyse" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding PickaxeSweetSpotDisplay}"
                                                   Margin="0,0,0,6"
                                                   FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPickaxeSweetSpot}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Materials}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="Transparent"
                                                                HorizontalAlignment="Left">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="MinWidth" Value="0" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Material}"
                                                                                     Value="{x:Static models:MiningMaterial.Ore}">
                                                                            <Setter Property="MinWidth" Value="48" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.ContextMenu>
                                                            <ContextMenu MinWidth="0"
                                                                         Padding="1"
                                                                         Placement="MousePoint"
                                                                         Background="White"
                                                                         BorderBrush="#FFD5DBE1"
                                                                         BorderThickness="1"
                                                                         Opened="OnMaterialContextMenuOpened"
                                                                         Closed="OnResetContextMenuClosed">
                                                                <ContextMenu.Template>
                                                                    <ControlTemplate TargetType="ContextMenu">
                                                                        <Border Padding="{TemplateBinding Padding}"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                                            <ItemsPresenter />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ContextMenu.Template>
                                                                <ContextMenu.Resources>
                                                                    <Style x:Key="MaterialResetMenuItemStyle"
                                                                           TargetType="MenuItem">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="Foreground" Value="#FF3C4043" />
                                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                                        <Setter Property="BorderThickness" Value="0" />
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="MenuItem">
                                                                                    <Border Padding="{TemplateBinding Padding}"
                                                                                            Background="{TemplateBinding Background}"
                                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                                                        <ContentPresenter ContentSource="Header"
                                                                                                          VerticalAlignment="Center"
                                                                                                          RecognizesAccessKey="True" />
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                                <Setter Property="Background" Value="#FFF0F1F3" />
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContextMenu.Resources>
                                                                <MenuItem MinWidth="0"
                                                                          Height="29"
                                                                          Padding="10,4"
                                                                          FontSize="12"
                                                                          Style="{StaticResource MaterialResetMenuItemStyle}"
                                                                          Click="OnResetMaterialCounterClick">
                                                                </MenuItem>
                                                            </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <TextBlock Text="{Binding DisplayName}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1"
                                                                   MinWidth="28"
                                                                   Margin="8,0,8,0"
                                                                   HorizontalAlignment="Right"
                                                                   Text="{Binding Count}"
                                                                   TextAlignment="Right"
                                                                   FontWeight="SemiBold" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMiningInspirations}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Moment of Inspiration">
                                                <TextBlock.ContextMenu>
                                                    <ContextMenu MinWidth="0"
                                                                 Padding="1"
                                                                 Placement="MousePoint"
                                                                 Background="White"
                                                                 BorderBrush="#FFD5DBE1"
                                                                 BorderThickness="1"
                                                                 Opened="OnMiningInspirationContextMenuOpened"
                                                                 Closed="OnResetContextMenuClosed">
                                                        <ContextMenu.Template>
                                                            <ControlTemplate TargetType="ContextMenu">
                                                                <Border Padding="{TemplateBinding Padding}"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <ItemsPresenter />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </ContextMenu.Template>
                                                        <ContextMenu.Resources>
                                                            <Style x:Key="MiningInspirationResetMenuItemStyle" TargetType="MenuItem">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="Foreground" Value="#FF3C4043" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="MenuItem">
                                                                            <Border Padding="{TemplateBinding Padding}"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                                <ContentPresenter ContentSource="Header"
                                                                                                  VerticalAlignment="Center"
                                                                                                  RecognizesAccessKey="True" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsHighlighted" Value="True">
                                                                        <Setter Property="Background" Value="#FFF0F1F3" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContextMenu.Resources>
                                                        <MenuItem Header="Reset Moment of Inspiration"
                                                                  MinWidth="0"
                                                                  Height="29"
                                                                  Padding="10,4"
                                                                  FontSize="12"
                                                                  Style="{StaticResource MiningInspirationResetMenuItemStyle}"
                                                                  Click="OnResetMiningInspirationClick" />
                                                    </ContextMenu>
                                                </TextBlock.ContextMenu>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1"
                                                       MinWidth="28"
                                                       Margin="8,0,8,0"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding MiningInspirationCount}"
                                                       TextAlignment="Right"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <StackPanel Margin="0,8,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasProspectingResult}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,0,8,0"
                                                            FontWeight="SemiBold"
                                                            Text="Prospecting Results"
                                                            ContextMenuService.IsEnabled="{Binding HasProspectingResult}">
                                                    <TextBlock.ContextMenu>
                                                        <ContextMenu MinWidth="0"
                                                                     Padding="1"
                                                                     Placement="MousePoint"
                                                                     Background="White"
                                                                     BorderBrush="#FFD5DBE1"
                                                                     BorderThickness="1"
                                                                     Opened="OnProspectingResultsContextMenuOpened"
                                                                     Closed="OnResetContextMenuClosed">
                                                            <ContextMenu.Template>
                                                                <ControlTemplate TargetType="ContextMenu">
                                                                    <Border Padding="{TemplateBinding Padding}"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                                        <ItemsPresenter />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </ContextMenu.Template>
                                                            <ContextMenu.Resources>
                                                                <Style x:Key="ProspectingResultsResetMenuItemStyle" TargetType="MenuItem">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="Foreground" Value="#FF3C4043" />
                                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="MenuItem">
                                                                                <Border Padding="{TemplateBinding Padding}"
                                                                                        Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                                                    <ContentPresenter ContentSource="Header"
                                                                                                      VerticalAlignment="Center"
                                                                                                      RecognizesAccessKey="True" />
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsHighlighted" Value="True">
                                                                            <Setter Property="Background" Value="#FFF0F1F3" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContextMenu.Resources>
                                                            <MenuItem Header="Reset Prospecting Results"
                                                                      MinWidth="0"
                                                                      Height="29"
                                                                      Padding="10,4"
                                                                      FontSize="12"
                                                                      Style="{StaticResource ProspectingResultsResetMenuItemStyle}"
                                                                      Click="OnResetProspectingResultsClick" />
                                                        </ContextMenu>
                                                    </TextBlock.ContextMenu>
                                                </TextBlock>
                                                <Border Grid.Column="1"
                                                        Height="1"
                                                        VerticalAlignment="Center"
                                                        Background="#FFE2E4E8" />
                                            </Grid>
                                            <Grid DataContext="{Binding VeinContext}">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.HasVeinContext, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Material" />
                                                <TextBlock Grid.Column="1" MinWidth="72" HorizontalAlignment="Right" Text="{Binding Material}" TextAlignment="Right" />
                                                <TextBlock Grid.Row="1" Text="Quality">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasKnownQuality}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Row="1" Grid.Column="1" MinWidth="72" HorizontalAlignment="Right" Text="{Binding QualityText}" TextAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasKnownQuality}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Row="2" Text="Remaining">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasKnownRemaining}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Grid Grid.Row="2" Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasKnownRemaining}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <TextBlock Margin="0,0,4,0"
                                                               HorizontalAlignment="Right"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FF1565C0"
                                                               Text="{Binding LocalExactRemainingDeltaText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LocalExactRemainingDeltaText}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                               HorizontalAlignment="Right"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FF1565C0"
                                                               Text="{Binding RemainingValueText}"
                                                               TextAlignment="Right" />
                                                </Grid>
                                                <TextBlock Grid.Row="3" Text="Confidence" />
                                                <TextBlock Grid.Row="3"
                                                           Grid.Column="1"
                                                           MinWidth="72"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding ConfidenceText}"
                                                           TextAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FF80868B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:VeinConfidence.Synchronized}">
                                                                    <Setter Property="Foreground" Value="#FF1565C0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:VeinConfidence.Tracking}">
                                                                    <Setter Property="Foreground" Value="#FF2E7D32" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:VeinConfidence.TypeOnly}">
                                                                    <Setter Property="Foreground" Value="#FFF9A825" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:VeinConfidence.Partial}">
                                                                    <Setter Property="Foreground" Value="#FFF9A825" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:VeinConfidence.Unknown}">
                                                                    <Setter Property="Foreground" Value="#FF80868B" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:VeinConfidence.Ambiguous}">
                                                                    <Setter Property="Foreground" Value="#FFE65100" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                             </Grid>
                                            <Grid DataContext="{Binding PlainRockProspectingResult}">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.HasPlainRockProspectingResult, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.HasVeinContext, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Material" />
                                                <TextBlock Grid.Column="1"
                                                           MinWidth="72"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding Title}"
                                                           TextAlignment="Right" />
                                                <TextBlock Grid.Row="1" Text="Quality">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasKnownQuality}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           MinWidth="72"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding QualityText}"
                                                           TextAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasKnownQuality}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Margin="0,8,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNearbyScan}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,0,8,0"
                                                            FontWeight="SemiBold"
                                                            Text="Nearby Scan"
                                                            ContextMenuService.IsEnabled="{Binding HasNearbyScan}">
                                                    <TextBlock.ContextMenu>
                                                        <ContextMenu MinWidth="0"
                                                                     Padding="1"
                                                                     Placement="MousePoint"
                                                                     Background="White"
                                                                     BorderBrush="#FFD5DBE1"
                                                                     BorderThickness="1"
                                                                     Opened="OnProspectingResultsContextMenuOpened"
                                                                     Closed="OnResetContextMenuClosed">
                                                            <ContextMenu.Template>
                                                                <ControlTemplate TargetType="ContextMenu">
                                                                    <Border Padding="{TemplateBinding Padding}"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                                        <ItemsPresenter />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </ContextMenu.Template>
                                                            <ContextMenu.Resources>
                                                                <Style x:Key="NearbyScanResetMenuItemStyle" TargetType="MenuItem">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="Foreground" Value="#FF3C4043" />
                                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="MenuItem">
                                                                                <Border Padding="{TemplateBinding Padding}"
                                                                                        Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                                                    <ContentPresenter ContentSource="Header"
                                                                                                      VerticalAlignment="Center"
                                                                                                      RecognizesAccessKey="True" />
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsHighlighted" Value="True">
                                                                            <Setter Property="Background" Value="#FFF0F1F3" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContextMenu.Resources>
                                                            <MenuItem Header="Reset Prospecting Results"
                                                                      MinWidth="0"
                                                                      Height="29"
                                                                      Padding="10,4"
                                                                      FontSize="12"
                                                                      Style="{StaticResource NearbyScanResetMenuItemStyle}"
                                                                      Click="OnResetProspectingResultsClick" />
                                                        </ContextMenu>
                                                    </TextBlock.ContextMenu>
                                                </TextBlock>
                                                <Border Grid.Column="1"
                                                        Height="1"
                                                        VerticalAlignment="Center"
                                                        Background="#FFE2E4E8" />
                                            </Grid>
                                            <StackPanel DataContext="{Binding NearbyScan}">
                                                <TextBlock Text="Only rock">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnlyRock}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnlyRock}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="0,2,0,0" Text="{Binding DisplayText}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Margin="0,0,10,0"
                                           Padding="4,0,0,0"
                                           Background="#FFF7F8FA"
                                           Text="{Binding TotalCount}"
                                           TextAlignment="Right"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
